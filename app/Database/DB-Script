-- Validation queries
SELECT COUNT(*) AS customer_count FROM customer;
SELECT COUNT(*) AS category_count FROM product_category;
SELECT COUNT(*) AS product_count FROM product_detail;
SELECT pc.category_name, COUNT(pd.product_id) AS product_count
FROM product_category pc LEFT JOIN product_detail pd ON pc.category_id = pd.category_id
GROUP BY pc.category_id, pc.category_name ORDER BY pc.category_id;

